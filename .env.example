HOST=127.0.0.1
PORT=3466
PRICEBTC_DATA_DIR=.data
LOG_LEVEL=info
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
COINBASE_API_URL=https://api.exchange.coinbase.com
FX_API_URL=https://open.er-api.com/v6/latest/USD
MAX_SSE_CLIENTS=500
MAX_SSE_CLIENTS_PER_IP=5

# Sats Bid is off by default. Use separate databases for dev/test/production.
APP_ENV=development
PUBLIC_SITE_URL=http://127.0.0.1:5173
DATABASE_URL=
SATS_DB_PASSWORD=
SATS_DB_PORT=55432
SATS_BID_ENABLED=false
BIDS_ENABLED=false
PAYMENT_PROVIDER=mock
MOCK_PAYMENTS_ENABLED=false
MOCK_WEBHOOK_SECRET=
MINIMUM_BID_SATS=1000
MAXIMUM_BID_SATS=1000000
INVOICE_TTL_SECONDS=600
BID_CUTOFF_SECONDS=120
INVOICE_END_BUFFER_SECONDS=60
ROUND_CLOSE_GRACE_SECONDS=300
RECONCILIATION_INTERVAL_SECONDS=60
PROVIDER_HTTP_TIMEOUT_SECONDS=10
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=
BTCPAY_NETWORK=mainnet
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
SUPPORT_CONTACT_URL=mailto:contact@foreign.rodeo
RULES_VERSION=1.0
MODERATION_MODE=auto_basic
# Optional dedicated PostgreSQL URL; integration tests create/drop only their own schema.
SATS_TEST_DATABASE_URL=
SATS_BACKUP_DIR=/var/lib/pricebtc/backups
# Deployment only: keep true while any real invoices require processing.
SATS_WORKER_ENABLED=false
SATS_DB_CONTAINER=pricebtc-sats-sats-db-1
# Preview build/runtime paths; avoid rebuilding the active dist directory.
PRICEBTC_PREVIEW_DIR=.data/sats-preview
# PRICEBTC_FRONTEND_DIR=/absolute/path/to/.data/sats-preview/client
## Optional server-side event receiver; must deduplicate event_id.
ANALYTICS_EXPORT_URL=
ANALYTICS_EXPORT_TOKEN=

# Plausible Analytics (optional)
PLAUSIBLE_DOMAIN=
PLAUSIBLE_API_KEY=

# Stripe configuration (optional, for Pro/Business API tiers)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# Crypto Sponsorship Configuration
# Deposit addresses - set at least one to enable crypto payments
# Production addresses (documented in docs/SPONSORS_CRYPTO_SETUP.md):
# SPONSOR_ADDR_USDC_SOL=6qRGFDj5ySnqYu5KDpDpUenqxzS2dtnyRLhmKtAGvoMs
# SPONSOR_ADDR_BTC=bc1qpcf3cludfwwu3jez7j7f406ck8psmne5cypkhf
SPONSOR_ADDR_USDT_TRC20=
SPONSOR_ADDR_USDC_SOL=
SPONSOR_ADDR_BTC=

# Minimum USD amounts (optional, defaults shown)
SPONSOR_MIN_USD_USDT=10.00
SPONSOR_MIN_USD_USDC=10.00
SPONSOR_MIN_USD_BTC=10.00

# Confirmation requirements (optional, defaults shown)
SPONSOR_CONFIRM_USDT_TRC20=19
SPONSOR_CONFIRM_USDC_SOL=32
SPONSOR_CONFIRM_BTC=3

# Explorer API endpoints (optional)
TRONSCAN_API_URL=https://apilist.tronscan.org
TRONSCAN_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_TOKEN=
BITCOIN_EXPLORER_URL=https://mempool.space/api
