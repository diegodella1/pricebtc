[Unit]
Description=PRICEB.TC signed GitHub deployment webhook
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=diego
Group=diego
WorkingDirectory=/home/diego/Documents/pricebtc
Environment=PATH=/home/diego/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/pricebtc/deploy.env
ExecStart=/usr/bin/node /usr/local/lib/pricebtc-deploy/deploy-webhook.mjs
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=120
UMask=0077

[Install]
WantedBy=multi-user.target
