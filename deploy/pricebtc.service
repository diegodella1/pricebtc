[Unit]
Description=PRICEB.TC live Bitcoin widgets
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=diego
Group=diego
WorkingDirectory=/home/diego/Documents/pricebtc
Environment=NODE_ENV=production
EnvironmentFile=-/etc/pricebtc/pricebtc.env
ExecStart=/usr/bin/node /home/diego/Documents/pricebtc/dist/server/index.js
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=15s
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/pricebtc
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
UMask=0077
LimitNOFILE=8192
TasksMax=128
MemoryMax=512M

[Install]
WantedBy=multi-user.target
