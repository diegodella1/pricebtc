{
  "name": "pricebtc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c orange,cyan \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build && node scripts/prepare-static.mjs dist/client",
    "build:static": "vite build --config vite.static.config.ts && node scripts/prepare-static.mjs pricebtc-freehosting",
    "build:server": "tsup src/server/index.ts src/server/sats-bid/worker-entry.ts --format esm --platform node --target node22 --out-dir dist/server --sourcemap --clean=false",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism",
    "test:deployment": "node --test scripts/test-deployment.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "smoke:static": "node scripts/smoke-static.mjs",
    "load:sse": "node scripts/load-sse.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:up": "docker compose -p pricebtc-sats -f compose.sats-bid.yml up -d --wait",
    "db:migrate": "tsx scripts/sats-db.ts",
    "dev:sats": "concurrently -k -n api,web,worker \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\" \"tsx watch src/server/sats-bid/worker-entry.ts\"",
    "worker": "node dist/server/sats-bid/worker-entry.js",
    "worker:dev": "tsx src/server/sats-bid/worker-entry.ts",
    "test:sats": "vitest run tests/sats-bid --maxWorkers=1 --no-file-parallelism",
    "db:seed": "tsx scripts/sats-seed.ts",
    "build:preview": "node scripts/build-preview.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@fontsource/bricolage-grotesque": "^5.2.8",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "argon2": "^0.45.1",
    "decimal.js": "^10.6.0",
    "fastify": "^5.6.1",
    "light-bolt11-decoder": "^3.2.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
